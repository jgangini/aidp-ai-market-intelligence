{
  "schema_version": 1,
  "project_id": "aidp-ai-market-intelligence",
  "terraform": {
    "path": "terraform",
    "package_oci_credentials": false
  },
  "capabilities": {
    "compartment_modes": [
      "new",
      "existing"
    ],
    "default_compartment_name": "ai-market-intelligence",
    "database_profile": "new_or_existing",
    "region_selection": "subscribed_compatible",
    "regional_requirements": [
      "aidp",
      "autonomous_26ai_dw",
      "genai_chat"
    ],
    "existing_database_wallet": "none"
  },
  "presentation": {
    "title": "AIDP AI Market Intelligence",
    "summary": "Deploys the Market Intelligence research agent, dedicated AI Compute and protected source credentials in Oracle AIDP Workbench. Includes web and social source connectors, evidence-linked responses, and installation, update and recovery hooks for Deploy Studio.",
    "tags": [
      "AI Data Platform Workbench",
      "Market Intelligence",
      "Apify"
    ],
    "href": "https://github.com/jgangini/aidp-ai_market-intelligence",
    "image": "/assets/oci-aidp-cloud-migration-lab.png",
    "image_alt": "AIDP AI Market Intelligence \u2014 Oracle AI Data Platform Workbench"
  },
  "form": {
    "fields": [
      {
        "name": "aidp_mode",
        "label": "Services mode",
        "type": "select",
        "required": true,
        "default": "new",
        "options": [
          {
            "value": "new",
            "label": "Create new AIDP"
          },
          {
            "value": "existing",
            "label": "Use existing AIDP"
          }
        ],
        "group": "aidp_platform"
      },
      {
        "name": "existing_ai_data_platform_ocid",
        "label": "Existing AIDP",
        "type": "select",
        "required": true,
        "pattern": "^ocid1\\.aidataplatform\\.[^\\s]+$",
        "visible_when": {
          "field": "aidp_mode",
          "equals": "existing"
        },
        "group": "aidp_platform",
        "options_source": "oci_aidp_platforms"
      },
      {
        "name": "existing_workspace_key",
        "label": "Existing workspace",
        "type": "select",
        "required": true,
        "pattern": "^[A-Za-z0-9_-]{1,128}$",
        "visible_when": {
          "field": "aidp_mode",
          "equals": "existing"
        },
        "group": "aidp_platform",
        "options_source": "oci_aidp_workspaces"
      },
      {
        "name": "identity_domain_id",
        "label": "Identity Domain",
        "type": "select",
        "options_source": "oci_identity_domains",
        "required": true,
        "pattern": "^ocid1\\.domain\\.[^\\s]+$",
        "group": "identity"
      },
      {
        "name": "admin_user_ocid",
        "label": "Administrator (new: assign; existing: verify roles)",
        "type": "select",
        "required": true,
        "options_source": "oci_aidp_administrators",
        "group": "identity"
      },
      {
        "name": "agent_model_id",
        "label": "Select Model",
        "type": "select",
        "required": true,
        "options_source": "oci_genai_chat_models",
        "group": "enterprise_ai"
      },
      {
        "name": "artifacts_bucket_mode",
        "label": "Artifacts bucket mode",
        "type": "select",
        "required": true,
        "default": "new",
        "options": [
          {
            "value": "new",
            "label": "Create new bucket"
          },
          {
            "value": "existing",
            "label": "Use existing bucket"
          }
        ],
        "group": "artifacts"
      },
      {
        "name": "artifacts_bucket_name",
        "label": "New artifacts bucket name",
        "type": "text",
        "required": true,
        "pattern": "^[A-Za-z0-9_.-]{1,256}$",
        "group": "artifacts",
        "visible_when": {
          "field": "artifacts_bucket_mode",
          "equals": "new"
        }
      },
      {
        "name": "existing_artifacts_bucket_name",
        "label": "Existing artifacts bucket",
        "type": "select",
        "required": true,
        "options_source": "oci_active_buckets",
        "pattern": "^[A-Za-z0-9_.-]{1,256}$",
        "group": "artifacts",
        "visible_when": {
          "field": "artifacts_bucket_mode",
          "equals": "existing"
        }
      },
      {
        "name": "apify_token",
        "label": "Apify token",
        "type": "password",
        "required": false,
        "secret": true,
        "transform": "none",
        "min_length": 20,
        "max_length": 512,
        "group": "enterprise_ai"
      },
      {
        "name": "test_session_id",
        "label": "Existing bound TEST session UUID (optional)",
        "type": "text",
        "required": false,
        "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$",
        "max_length": 36,
        "group": "aidp_platform"
      },
      {
        "name": "autonomous_database_mode",
        "label": "Database mode",
        "type": "select",
        "required": true,
        "default": "new",
        "group": "database",
        "options": [
          {
            "value": "new",
            "label": "Create new database"
          },
          {
            "value": "existing",
            "label": "Use existing database"
          }
        ]
      },
      {
        "name": "autonomous_database_version",
        "label": "Database profile",
        "type": "select",
        "required": true,
        "default": "26ai:DW",
        "group": "database",
        "transform": "database_profile",
        "options": [
          {
            "value": "26ai:DW",
            "label": "Oracle AI Database 26ai \u00b7 Autonomous AI Lakehouse"
          }
        ],
        "visible_when": {
          "field": "autonomous_database_mode",
          "equals": "new"
        }
      },
      {
        "name": "autonomous_database_compute_count",
        "label": "Memory database ECPUs",
        "type": "number",
        "required": true,
        "default": 4,
        "group": "database",
        "visible_when": {
          "field": "autonomous_database_mode",
          "equals": "new"
        }
      },
      {
        "name": "existing_autonomous_database_ocid",
        "label": "Existing Autonomous Database",
        "type": "select",
        "required": true,
        "group": "database",
        "pattern": "^ocid1\\.autonomousdatabase\\.[^\\s]+$",
        "visible_when": {
          "field": "autonomous_database_mode",
          "equals": "existing"
        },
        "options_source": "oci_autonomous_databases"
      },
      {
        "name": "autonomous_database_admin_password",
        "label": "Database admin password",
        "type": "password",
        "secret": true,
        "required": false,
        "transform": "none",
        "min_length": 12,
        "max_length": 30,
        "group": "database"
      }
    ]
  },
  "run_steps": [
    {
      "key": "queue",
      "label": "Queue"
    },
    {
      "key": "credentials",
      "label": "Verify operator, administrator and Apify access"
    },
    {
      "key": "compartment",
      "label": "Target compartment"
    },
    {
      "key": "plan",
      "label": "Review owned and external resources"
    },
    {
      "key": "apply",
      "label": "Provision selected resources"
    },
    {
      "key": "application",
      "label": "Install paused TEST agent"
    },
    {
      "key": "complete",
      "label": "Installation result"
    }
  ],
  "outputs": [
    "ai_data_platform_ocid",
    "workspace_key",
    "workspace_name",
    "artifacts_bucket_name",
    "objectstorage_namespace",
    "region",
    "home_region",
    "compartment_id",
    "identity_domain_id",
    "identity_domain_url",
    "admin_user_ocid",
    "agent_model_id",
    "owned_ai_data_platform",
    "owned_artifacts_bucket",
    "deployment_binding",
    "installation_status",
    "installation_phase",
    "operation_id",
    "research_enabled",
    "deployment_surface",
    "apify_execution_permission",
    "maintenance_action",
    "autonomous_database_id",
    "owned_autonomous_database",
    "memory_status",
    "configured_agent_model_id"
  ],
  "artifacts": [],
  "preflight": {
    "entrypoint": "terraform/hooks/preflight.py",
    "timeout_seconds": 300,
    "requires_oci_credentials": true,
    "secret_inputs": [
      "apify_token",
      "autonomous_database_admin_password"
    ],
    "output_inputs": [
      "home_region",
      "identity_domain_url",
      "objectstorage_namespace",
      "artifacts_bucket_name"
    ],
    "runtime_fields": [
      {
        "name": "home_region",
        "label": "Tenancy home region",
        "type": "text",
        "required": true,
        "pattern": "^[a-z]{2}-[a-z0-9-]+-[0-9]+$"
      },
      {
        "name": "identity_domain_url",
        "label": "Verified Identity Domain endpoint",
        "type": "text",
        "required": true,
        "pattern": "^https://[A-Za-z0-9.-]+/?$"
      },
      {
        "name": "objectstorage_namespace",
        "label": "Verified Object Storage namespace",
        "type": "text",
        "required": true,
        "pattern": "^[A-Za-z0-9_-]{1,256}$"
      }
    ]
  },
  "post_apply": {
    "entrypoint": "terraform/hooks/post_apply.py",
    "timeout_seconds": 3600,
    "requires_oci_credentials": true,
    "include_paths": [
      "src",
      "aidp",
      "package",
      "pyproject.toml",
      "uv.lock"
    ],
    "secret_inputs": [
      "apify_token",
      "autonomous_database_admin_password"
    ]
  }
}
