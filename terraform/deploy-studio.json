{
  "schema_version": 2,
  "execution_source": "oci_resource_manager",
  "project_id": "aidp-ai-market-intelligence",
  "terraform": {
    "path": "terraform",
    "package_oci_credentials": false
  },
  "capabilities": {
    "compartment_modes": [
      "new",
      "existing"
    ],
    "default_compartment_name": "ai-market-intelligence",
    "database_profile": "new_or_existing",
    "region_selection": "subscribed_compatible",
    "regional_requirements": [
      "aidp",
      "autonomous_26ai_dw",
      "genai_chat"
    ],
    "existing_database_wallet": "none"
  },
  "presentation": {
    "title": "AIDP AI Market Intelligence",
    "summary": "Deploys a Market Intelligence agent in Oracle AIDP Workbench with protected memory and a selected model. Apify supplies web and social data through Actors used by the agent for evidence-linked research. Get your token in Apify Console → Settings → API & Integrations. Preflight checks account and configured Actor/build visibility without starting runs; execution permissions and paid access remain unverified. Research starts paused.",
    "tags": [
      "AI Data Platform Workbench",
      "Market Intelligence",
      "Apify"
    ],
    "href": "https://github.com/jgangini/aidp-ai_market-intelligence",
    "image": "/assets/oci-aidp-cloud-migration-lab.png",
    "image_alt": "AIDP AI Market Intelligence — Oracle AI Data Platform Workbench"
  },
  "form": {
    "fields": [
      {
        "name": "aidp_mode",
        "label": "Services mode",
        "type": "select",
        "required": true,
        "default": "new",
        "options": [
          {
            "value": "new",
            "label": "Create new AIDP"
          },
          {
            "value": "existing",
            "label": "Use existing AIDP"
          }
        ],
        "group": "aidp_platform",
        "span": 1
      },
      {
        "name": "new_aidp_name",
        "label": "New AIDP name",
        "type": "text",
        "required": true,
        "default": "aidp_market_intelligence",
        "min_length": 1,
        "max_length": 255,
        "pattern": "^[A-Za-z0-9][A-Za-z0-9._ -]{0,254}$",
        "span": 1,
        "group": "aidp_platform",
        "visible_when": {
          "field": "aidp_mode",
          "equals": "new"
        }
      },
      {
        "name": "existing_ai_data_platform_ocid",
        "label": "Existing AIDP",
        "type": "select",
        "options_source": "oci_aidp_platforms",
        "required": true,
        "visible_when": {
          "field": "aidp_mode",
          "equals": "existing"
        },
        "pattern": "^ocid1\\.aidataplatform\\.[^\\s]+$",
        "group": "aidp_platform"
      },
      {
        "name": "existing_workspace_key",
        "label": "Existing workspace",
        "type": "select",
        "required": true,
        "visible_when": {
          "field": "aidp_mode",
          "equals": "existing"
        },
        "pattern": "^[A-Za-z0-9_-]{1,128}$",
        "group": "aidp_platform",
        "options_source": "oci_aidp_workspaces"
      },
      {
        "name": "identity_domain_id",
        "label": "Identity Domain",
        "type": "select",
        "required": true,
        "options_source": "oci_identity_domains",
        "pattern": "^ocid1\\.domain\\.[^\\s]+$",
        "group": "identity"
      },
      {
        "name": "admin_user_ocid",
        "label": "AIDP administrator",
        "type": "select",
        "required": true,
        "options_source": "oci_aidp_administrators",
        "group": "identity"
      },
      {
        "name": "artifacts_bucket_mode",
        "label": "Artifacts bucket mode",
        "type": "select",
        "required": true,
        "default": "existing",
        "options": [
          {
            "value": "new",
            "label": "Create new bucket"
          },
          {
            "value": "existing",
            "label": "Use existing bucket"
          }
        ],
        "group": "artifacts"
      },
      {
        "name": "artifacts_bucket_name",
        "label": "New artifacts bucket name",
        "type": "text",
        "required": true,
        "pattern": "^[A-Za-z0-9_.-]{1,256}$",
        "min_length": 1,
        "max_length": 128,
        "group": "artifacts",
        "visible_when": {
          "field": "artifacts_bucket_mode",
          "equals": "new"
        }
      },
      {
        "name": "existing_artifacts_bucket_name",
        "label": "Existing artifacts bucket",
        "type": "select",
        "options_source": "oci_active_buckets",
        "required": true,
        "visible_when": {
          "field": "artifacts_bucket_mode",
          "equals": "existing"
        },
        "pattern": "^[A-Za-z0-9_.-]{1,256}$",
        "min_length": 1,
        "max_length": 128,
        "group": "artifacts"
      },
      {
        "name": "agent_model_id",
        "label": "Select Model",
        "type": "select",
        "required": true,
        "default": "xai.grok-4.7",
        "options_source": "oci_genai_chat_models",
        "group": "enterprise_ai"
      },
      {
        "name": "apify_token",
        "label": "Apify token",
        "type": "password",
        "required": false,
        "secret": true,
        "transform": "none",
        "min_length": 20,
        "max_length": 512,
        "group": "enterprise_ai"
      },
      {
        "name": "autonomous_database_mode",
        "label": "Database mode",
        "type": "select",
        "required": true,
        "default": "new",
        "options": [
          {
            "value": "new",
            "label": "Create new database"
          },
          {
            "value": "existing",
            "label": "Use existing database"
          }
        ],
        "group": "database"
      },
      {
        "name": "autonomous_database_version",
        "label": "Database profile",
        "type": "select",
        "required": true,
        "default": "26ai:DW",
        "transform": "database_profile",
        "options": [
          {
            "value": "26ai:DW",
            "label": "Oracle AI Database 26ai · AI Lakehouse (DW)"
          }
        ],
        "visible_when": {
          "field": "autonomous_database_mode",
          "equals": "new"
        },
        "group": "database"
      },
      {
        "name": "existing_autonomous_database_ocid",
        "label": "Existing Autonomous Database",
        "type": "select",
        "required": true,
        "pattern": "^ocid1\\.autonomousdatabase\\.[^\\s]+$",
        "visible_when": {
          "field": "autonomous_database_mode",
          "equals": "existing"
        },
        "group": "database",
        "options_source": "oci_autonomous_databases"
      },
      {
        "name": "autonomous_database_admin_password",
        "label": "Database admin password",
        "type": "password",
        "required": false,
        "secret": true,
        "min_length": 12,
        "max_length": 30,
        "group": "database",
        "generate_password": true,
        "generate_password_when": {
          "field": "autonomous_database_mode",
          "equals": "new"
        },
        "transform": "none"
      }
    ],
    "groups": [
      {
        "id": "credentials",
        "title": "OCI credentials",
        "items": [
          {
            "kind": "control",
            "name": "oci_config",
            "label": "OCI config"
          },
          {
            "kind": "control",
            "name": "oci_key",
            "label": "API private key"
          }
        ]
      },
      {
        "id": "services",
        "title": "Services to deploy",
        "items": [
          {
            "kind": "control",
            "name": "oci_region",
            "label": "OCI Region",
            "span": 2
          },
          {
            "kind": "control",
            "name": "compartment_mode",
            "label": "Compartment mode",
            "options": [
              {
                "value": "new",
                "label": "New compartment"
              },
              {
                "value": "existing",
                "label": "Existing compartment"
              }
            ]
          },
          {
            "kind": "control",
            "name": "new_compartment",
            "label": "New compartment name"
          },
          {
            "kind": "control",
            "name": "existing_compartment",
            "label": "Existing compartment"
          }
        ]
      },
      {
        "id": "identity",
        "title": "Identity",
        "items": [
          {
            "kind": "field",
            "name": "identity_domain_id",
            "span": 1
          },
          {
            "kind": "field",
            "name": "admin_user_ocid",
            "span": 1
          }
        ]
      },
      {
        "id": "aidp_platform",
        "title": "AI Data Platform Workbench",
        "items": [
          {
            "kind": "field",
            "name": "aidp_mode",
            "span": 1
          },
          {
            "kind": "field",
            "name": "new_aidp_name",
            "span": 1
          },
          {
            "kind": "field",
            "name": "existing_ai_data_platform_ocid",
            "span": 1
          },
          {
            "kind": "field",
            "name": "existing_workspace_key",
            "span": 1
          }
        ]
      },
      {
        "id": "enterprise_ai",
        "title": "AI Data Platform Workbench Agent Flow",
        "items": [
          {
            "kind": "field",
            "name": "agent_model_id",
            "span": 1
          },
          {
            "kind": "field",
            "name": "apify_token",
            "span": 1
          }
        ]
      },
      {
        "id": "artifacts",
        "title": "Artifacts",
        "items": [
          {
            "kind": "field",
            "name": "artifacts_bucket_mode",
            "span": 1
          },
          {
            "kind": "field",
            "name": "artifacts_bucket_name",
            "span": 1
          },
          {
            "kind": "field",
            "name": "existing_artifacts_bucket_name",
            "span": 1
          }
        ]
      },
      {
        "id": "database",
        "title": "Oracle AI Database",
        "items": [
          {
            "kind": "field",
            "name": "autonomous_database_mode",
            "span": 1
          },
          {
            "kind": "field",
            "name": "autonomous_database_version",
            "span": 1
          },
          {
            "kind": "field",
            "name": "existing_autonomous_database_ocid",
            "span": 1
          },
          {
            "kind": "field",
            "name": "autonomous_database_admin_password",
            "span": 1
          }
        ]
      }
    ]
  },
  "run_steps": [
    {
      "key": "queue",
      "label": "Queue"
    },
    {
      "key": "credentials",
      "label": "Verify operator, administrator and Apify access"
    },
    {
      "key": "compartment",
      "label": "Target compartment"
    },
    {
      "key": "plan",
      "label": "Review owned and external resources"
    },
    {
      "key": "apply",
      "label": "Provision selected resources"
    },
    {
      "key": "application",
      "label": "Install paused TEST agent"
    },
    {
      "key": "complete",
      "label": "Installation result"
    }
  ],
  "outputs": [
    "ai_data_platform_ocid",
    "workspace_key",
    "workspace_name",
    "artifacts_bucket_name",
    "objectstorage_namespace",
    "region",
    "home_region",
    "compartment_id",
    "identity_domain_id",
    "identity_domain_url",
    "admin_user_ocid",
    "agent_model_id",
    "owned_ai_data_platform",
    "owned_artifacts_bucket",
    "deployment_binding",
    "installation_status",
    "installation_phase",
    "operation_id",
    "research_enabled",
    "deployment_surface",
    "apify_execution_permission",
    "maintenance_action",
    "autonomous_database_id",
    "owned_autonomous_database",
    "memory_status",
    "configured_agent_model_id"
  ],
  "artifacts": [],
  "preflight": {
    "entrypoint": "terraform/hooks/preflight.py",
    "timeout_seconds": 300,
    "requires_oci_credentials": true,
    "secret_inputs": [
      "apify_token",
      "autonomous_database_admin_password"
    ],
    "output_inputs": [
      "home_region",
      "identity_domain_url",
      "objectstorage_namespace",
      "artifacts_bucket_name"
    ],
    "runtime_fields": [
      {
        "name": "home_region",
        "label": "Tenancy home region",
        "type": "text",
        "required": true,
        "pattern": "^[a-z]{2}-[a-z0-9-]+-[0-9]+$"
      },
      {
        "name": "identity_domain_url",
        "label": "Verified Identity Domain endpoint",
        "type": "text",
        "required": true,
        "pattern": "^https://[A-Za-z0-9.-]+/?$"
      },
      {
        "name": "objectstorage_namespace",
        "label": "Verified Object Storage namespace",
        "type": "text",
        "required": true,
        "pattern": "^[A-Za-z0-9_-]{1,256}$"
      }
    ]
  },
  "post_apply": {
    "entrypoint": "terraform/hooks/post_apply.py",
    "timeout_seconds": 3600,
    "requires_oci_credentials": true,
    "include_paths": [
      "src",
      "aidp",
      "package",
      "pyproject.toml",
      "uv.lock"
    ],
    "secret_inputs": [
      "apify_token",
      "autonomous_database_admin_password"
    ]
  }
}
