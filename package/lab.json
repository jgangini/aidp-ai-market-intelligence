  "agent": {
    "name": "ai_market_intelligence",
    "memory": "AIDP_SESSION_AND_OBJECT_STORAGE",
    "streaming": "graph_milestones",
    "graphs": "optional",
    "card": {
      "name": "ai_market_intelligence",
      "description": "On-demand evidence-based market research with authenticated AIDP sessions and conditional Object Storage ledgers. The installed agent stays paused on TEST until native acceptance; no automatic scheduled dispatch or visual charts are enabled.",
      "version": "2.2.0",
      "capabilities": {
        "isStreaming": true
      },
      "skills": [
        {
          "id": "approved_market_research",
          "name": "Research approved market sources",
          "description": "Investigate a company or market within an explicit time window and approved source and budget scope. Contrast retrieved evidence, preserve citations and limitations, and return a partial report when coverage is insufficient. Supports reviewed web, X, World Bank and daily financial-history adapters; does not claim complete social coverage.",
          "tags": [
            "market-research",
            "evidence",
            "approved-sources"
          ],
          "examples": [
            "Investiga las novedades de D1 en Colombia en los ultimos siete dias usando las fuentes aprobadas."
          ]
        },
        {
          "id": "stored_report_followup",
          "name": "Explain stored research",
          "description": "Answer follow-up questions using the report and evidence already recovered. Can summarize or show comparable data as a table without starting another paid extraction. Does not promise a rendered visual chart.",
          "tags": [
            "reports",
            "follow-up",
            "evidence"
          ],
          "examples": [
            "Resume el informe anterior en dos frases sin hacer otra extraccion."
          ]
        },
        {
          "id": "registered_topic_sources",
          "name": "List registered topic sources",
          "description": "List active source destinations registered for the authenticated user and canonical topic. Distinguish discovery scope and suspended adapters. This reads the catalog; interpretation uses the configured model and does not run Apify Actors.",
          "tags": [
            "sources",
            "catalog",
            "read-only"
          ],
          "examples": [
            "Que fuentes y destinos tengo registrados para el tema actual?"
          ]
        }
      ]
    }
  },
